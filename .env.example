# Firebase project
GCLOUD_PROJECT=jk-ai-app-builder

# Server-only OpenAI configuration. Bind OPENAI_API_KEY as a Firebase secret.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# HighLevel OAuth and API gateway
HL_CLIENT_ID=
HL_CLIENT_SECRET=
HL_REDIRECT_URI=
HL_API_BASE=https://services.leadconnectorhq.com

# Comma-separated frontend origins allowed by HTTP functions
APP_ORIGINS=http://localhost:5173
APP_BASE_URL=http://localhost:5173
