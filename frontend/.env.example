VITE_FUNCTIONS_BASE_URL=
# Optional when the REST API is hosted somewhere other than VITE_FUNCTIONS_BASE_URL + /v1.
VITE_API_V1_BASE_URL=
# Optional: override where the streaming generateApp call is sent. Left unset, it is derived
# automatically (https://us-central1-<VITE_FIREBASE_PROJECT_ID>.cloudfunctions.net/apiV1/v1) so the SSE
# stream bypasses Firebase Hosting, which buffers whole responses on /api rewrites and breaks streaming.
VITE_FUNCTIONS_STREAM_BASE_URL=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=demo-genesis
VITE_FIREBASE_APP_ID=
VITE_USE_FIREBASE_EMULATORS=true
