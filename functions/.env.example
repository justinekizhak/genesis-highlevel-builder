# Non-secret Firebase Function parameters
OPENAI_MODEL=gpt-5.4-mini
HL_CLIENT_ID=
HL_REDIRECT_URI=http://127.0.0.1:5001/demo-genesis/us-central1/hlAuthCallback
HL_API_BASE=https://services.leadconnectorhq.com
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_BASE_URL=http://localhost:5173

# PEM-encoded Ed25519 public key HighLevel publishes for webhook signature verification
# (marketplace app settings -> Webhooks). Leave empty locally; hlWebhook rejects every
# delivery with 401 until this is set, so webhooks are effectively off until deployed.
HL_WEBHOOK_PUBLIC_KEY=

# Set secrets with the Firebase CLI; never place their values in this file:
# printf '%s' 'your-api-key' | firebase functions:secrets:set OPENAI_API_KEY --data-file=-
# Redeploy generateApp after changing the secret. A 401 from OpenAI means the stored key was rejected.
# firebase functions:secrets:set HL_CLIENT_SECRET

# Multiple UI variations (four candidates, two finalists), always on when the planner classifies
# a request as a variations request.
OPENAI_VARIATION_PLANNER_MODEL=gpt-5.4-mini
OPENAI_VARIATION_GRADER_MODEL=gpt-5.4
