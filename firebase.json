{
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "predeploy": ["pnpm --dir functions build"]
  },
  "hosting": {
    "public": "frontend/dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [{ "key": "Cache-Control", "value": "public,max-age=31536000,immutable" }]
      },
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
        ]
      }
    ],
    "rewrites": [
      { "source": "/api/healthz", "function": { "functionId": "healthz", "region": "us-central1" } },
      { "source": "/api/generateApp", "function": { "functionId": "generateApp", "region": "us-central1" } },
      { "source": "/api/projectSnapshots", "function": { "functionId": "projectSnapshots", "region": "us-central1" } },
      { "source": "/api/saveFiles", "function": { "functionId": "saveFiles", "region": "us-central1" } },
      { "source": "/api/restoreSnapshot", "function": { "functionId": "restoreSnapshot", "region": "us-central1" } },
      { "source": "/api/projectState", "function": { "functionId": "projectState", "region": "us-central1" } },
      { "source": "/api/hlOAuthStart", "function": { "functionId": "hlOAuthStart", "region": "us-central1" } },
      { "source": "/api/hlAuthCallback", "function": { "functionId": "hlAuthCallback", "region": "us-central1" } },
      { "source": "/api/hlConnectionStatus", "function": { "functionId": "hlConnectionStatus", "region": "us-central1" } },
      { "source": "/api/integrationStatus", "function": { "functionId": "integrationStatus", "region": "us-central1" } },
      { "source": "/api/hlProxy", "function": { "functionId": "hlProxy", "region": "us-central1" } },
      { "source": "**", "destination": "/index.html" }
    ],
    "predeploy": ["pnpm --dir frontend build"]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "auth": { "port": 9099 },
    "functions": { "port": 5001 },
    "firestore": { "port": 8080 },
    "hosting": { "port": 5000 },
    "ui": { "enabled": true, "port": 4000 },
    "singleProjectMode": true
  }
}
